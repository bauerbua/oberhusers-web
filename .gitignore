/node_modules
/dist

# Composer-Pakete werden im CI installiert und per Deployment auf den Server
# geladen. Nur composer.json/composer.lock sind versioniert.
/backend/vendor

# Echte Zugangsdaten bleiben lokal bzw. auf dem Server. Versioniert ist nur
# die Vorlage; im Deployment liegt `config.php` unter `httpdocs/api/private/`
# und wird manuell per FTPS gepflegt.
/private/*
!/private/config.example.php

# Lokale Variante des Deployment-Ordners (config + vendor bleiben Handarbeit)
/public/api/private/config.php
/public/api/private/vendor/

# Lokale Zugangsdaten: nicht committen (vom Deployment nicht benötigt)
/.env

# State-Dateien des FTP-Deployers (Ziel: Server, nicht Repo)
.ftp-deploy-*.json

# Astro-Generat: Types, Dev-Server-Zustand, Preview-Logs
/.astro/

# Impeccable-Arbeitsbereich: Review-Captures, Live-Sessions und Critique
# sind Sitzungsartefakte, keine Projektdateien. Getrackt bleiben die
# dauerhaften Stücke (.impeccable/surfaces, /decision, /refs, design.json).
/.impeccable/review/
/.impeccable/live/
/.impeccable/critique/
