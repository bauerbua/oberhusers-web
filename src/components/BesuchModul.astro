---
export interface Props {
    kompakt?: boolean;
}
const { kompakt = false } = Astro.props;
---

<section id="besuch" class="scroll-mt-20 px-5 md:px-8">
    <div
        class={`relative overflow-hidden rounded-[28px] border-2 border-braun/20 bg-gradient-to-b from-altrosa/40 to-chalk p-6 md:rounded-[32px] md:p-12 ${kompakt ? "" : "mt-16"}`}
    >
        <!-- Die zwei Eck-Doodles des Brand-Kit: Zweig oben links, Blume unten rechts. -->
        <svg
            aria-hidden="true"
            viewBox="0 0 64 64"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="absolute left-4 top-4 h-14 w-14 text-braun/35 md:h-16 md:w-16"
        >
            <path d="M12 50 C 18 34 30 20 48 12" />
            <path d="M28 30 q-10 -2 -14 -10 q10 0 16 6" fill="none" />
            <path d="M36 22 q-2 -10 8 -14 q0 8 -6 14" fill="none" />
        </svg>
        <svg
            aria-hidden="true"
            viewBox="0 0 64 64"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="absolute bottom-4 right-4 h-16 w-16 text-braun/35 md:h-20 md:w-20"
        >
            <path d="M18 58 q2 -18 10 -30" />
            <path d="M28 28 q-3 -8 3 -12 q3 7 -1 12" fill="none" />
            <path d="M34 34 q-1 -9 6 -12 q1 8 -4 13" fill="none" />
            <path d="M46 52 q0 -10 6 -14" />
        </svg>
        <h2 class="font-heading text-4xl font-bold leading-[1.05] md:text-5xl">
            Die Stalltür steht offen — kommt vorbei
        </h2>
        <p class="mt-3 max-w-[60ch] text-braun/70">
            Kommt vorbei, schaut in den Stall, holt Eier aus dem Kühlschrank.
            Wir freuen uns auf euch. [Entwurf]
        </p>
        {!kompakt && (
            <div class="mt-6 grid gap-4 text-[15px] md:grid-cols-3">
                <div class="rounded-xl border-2 border-braun/20 bg-chalk p-4">
                    <strong>Standort</strong>
                    <br />
                    [Adresse TBD] · Karte [Embed TBD]
                </div>
                <div class="rounded-xl border-2 border-braun/20 bg-chalk p-4">
                    <strong>Anreise</strong>
                    <br />
                    ÖV Langnau/Emmenmatt · Parken [TBD]
                </div>
                <div class="rounded-xl border-2 border-braun/20 bg-chalk p-4">
                    <strong>Kontakt</strong>
                    <br />
                    [Tel/Mail TBD] · Eierkühlschrank jederzeit, bar/QR
                </div>
            </div>
        )}
        {kompakt && (
            <p class="mt-3 text-[15px]">
                Anfahrt kurz + Kontakt [TBD] ·{" "}
                <a
                    class="font-semibold text-braun underline underline-offset-4"
                    href="/ueber-uns#besuch"
                >
                    Details
                </a>
            </p>
        )}
    </div>
</section>
