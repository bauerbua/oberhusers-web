---
export interface Props { kompakt?: boolean; }
const { kompakt = false } = Astro.props;
---
<section id="besuch" class="scroll-mt-20 px-5 md:px-8">
  <div class={`rounded-[28px] border-2 border-weide/80 bg-gradient-to-b from-dotter/25 to-chalk p-6 md:rounded-[32px] md:p-12 ${kompakt ? "" : "mt-16"}`}>
    <h2 class="font-display text-2xl font-extrabold tracking-tight md:text-3xl">Die Stalltür steht offen — kommt vorbei</h2>
    <p class="mt-2 max-w-[60ch] text-ink/70">Kommt vorbei, schaut in den Stall, holt Eier aus dem Kühlschrank. Wir freuen uns auf euch. [Entwurf]</p>
    {!kompakt && (
      <div class="mt-6 grid gap-4 text-[15px] md:grid-cols-3">
        <div class="rounded-xl border-2 border-line bg-surface p-4"><strong>Standort</strong><br />[Adresse TBD] · Karte [Embed TBD]</div>
        <div class="rounded-xl border-2 border-line bg-surface p-4"><strong>Anreise</strong><br />ÖV Langnau/Emmenmatt · Parken [TBD]</div>
        <div class="rounded-xl border-2 border-line bg-surface p-4"><strong>Kontakt</strong><br />[Tel/Mail TBD] · Eierkühlschrank jederzeit, bar/QR</div>
      </div>
    )}
    {kompakt && <p class="mt-3 text-[15px]">Anfahrt kurz + Kontakt [TBD] · <a class="font-semibold text-weide underline underline-offset-4" href="/ueber-uns#besuch">Details</a></p>}
  </div>
</section>
