---
import { Picture } from "astro:assets";
import eier from "../assets/fotos/eier.jpg";
import kinder from "../assets/fotos/traktoren.jpg";
import milch from "../assets/fotos/kaelber.jpg";
import acker from "../assets/fotos/garten-blumen.jpg";

const sparten = [
    {
        name: "Eier",
        icon: "huhn",
        text: "Kühlschrank und Abos laufen weiter — neu vom Partner-Hof, mit derselben Sorgfalt.",
        href: "/eier",
        cta: "Eier entdecken",
        bild: eier,
        farbe: "bg-gelb",
        alt: "Braune Eier liegen dicht an dicht in einer Schicht aus Spelzen.",
    },
    {
        name: "Milch",
        icon: "kuh",
        text: "40 Kühe auf der Weide — Milch für echten Emmentaler aus dem Emmental.",
        href: "/milch",
        cta: "Kühe kennenlernen",
        notiz: "40 Kühe",
        bild: milch,
        farbe: "bg-altrosa",
        alt: "Drei Kälber mit gelben Ohrmarken schauen über den Stallzaun in die Kamera.",
    },
    {
        name: "Ackerbau",
        icon: "apfel",
        text: "Futter, Kartoffeln, Wald und Obst: der Kreislauf hinter allem.",
        href: "/ackerbau",
        cta: "Feld & Obst sehen",
        notiz: "30 ha",
        bild: acker,
        farbe: "bg-gruen",
        alt: "Ein Beet mit gelben und rosa Blüten vor einer Holzfassade mit bunter Girlande.",
    },
    {
        name: "Kindernachmittage",
        icon: "hund",
        text: "Einmal im Monat auf den Hof: Tiere kennen, mitarbeiten, draussen sein.",
        href: "/kindernachmittage",
        cta: "Nachmittag finden",
        notiz: "1× im Monet",
        bild: kinder,
        farbe: "bg-gelb",
        alt: "Eine Reihe bunter Tret-Traktoren steht vor einer Holzwand im Stall.",
    },
] as const;
---

<section>
    <h2>Das gibts bei uns</h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 py-6">
        {sparten.map((sparte) => (
            /* TODO: apply bg color only on hover, and maybe use a bit of opactiy to make the color lighter. Why does only bg-gelb work with hover currently? */
            <a
                href={sparte.href}
                class={`card rounded-2xl p-4 transition-all duration-300 hover:${sparte.farbe}`}
            >
                <div class="aspect-square">
                    <Picture
                        src={sparte.bild}
                        alt={sparte.alt}
                        class="object-cover w-full h-full rounded-2xl"
                    />
                </div>
                <h3 class="pt-4">
                    {sparte.name}
                </h3>
                <p>{sparte.text}</p>
            </a>
        ))}
    </div>
</section>
