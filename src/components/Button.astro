---
interface Props {
  href?: string;
  tone?: "egg" | "wiese" | "rind";
  shape?: 1 | 2 | 3;
  type?: "button" | "submit" | "reset";
  class?: string;
}
const { href, tone = "egg", shape = 1, type = "button", class: className } = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag
  class:list={["btn", `shape-${shape}`, `tone-${tone}`, className]}
  href={href}
  type={href ? undefined : type}
>
  <slot />
</Tag>