---
interface Props {
    href?: string;
    tone?: "egg" | "wiese" | "rind";
    shape?: 1 | 2 | 3;
    type?: "button" | "submit" | "reset";
    class?: string;
    target?: "_blank";
    id?: string;
}
const {
    href,
    tone = "egg",
    shape = 1,
    type = "button",
    class: className,
    target,
    id,
} = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
    class:list={["btn", `shape-${shape}`, `tone-${tone}`, "w-fit", className]}
    href={href}
    target={target}
    type={href ? undefined : type}
    id={id}
>
    <slot />
</Tag>
