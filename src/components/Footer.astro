---
import { Picture } from "astro:assets";
import wave from "../../assets/design-system/huegel-1-umriss.svg";
import logo from "../../assets/design-system/logo-abzeichen.svg";
import { navLinks } from "./Navigation.astro";

const mapsGoogle = `https://maps.app.goo.gl/8Yos99G2Ds8M21uH6`;
const linkedin = `https://www.linkedin.com/in/jakob-bauer-167669257`;
---

<footer class="mt-32">
    <div class="content-section my-20">
        <div class="flex flex-col gap-20 items-start justify-between flex-wrap md:flex-row md:items-center">
            <div class="flex flex-col justify-center items-center">
                <Picture
                    src={logo}
                    formats={["svg"]}
                    alt=""
                    class="block w-60"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
                <strong class="font-heading text-6xl text-center mt-2">
                    Oberhusers <br />
                    Burehof
                </strong>
            </div>
            <div class="grid grid-cols-2 gap-x-16 gap-y-4">
                {navLinks.map((l) => (
                    <a href={l.href} class="il w-fit" style={`--c: ${l.tone}`}>
                        {l.label}
                    </a>
                ))}
                <a
                    href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/impressum`}
                    class="il w-fit"
                    style="--c: var(--color-altrosa)"
                >
                    Impressum
                </a>
            </div>
            <address class="not-italic">
                <a
                    href={mapsGoogle}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="il w-fit"
                    style="--c: var(--color-gelb)"
                >
                    Oberhusers Burehof
                    <br />
                    Bembrunnen 7<br />
                    3535 Schüpbach
                    <span class="sr-only">
                        (öffnet Google Maps in neuem Tab)
                    </span>
                </a>
            </address>
        </div>
    </div>

    <div class="content-section">
        <p
            class="m-0 border-t-2 border-braun/15 py-6 text-sm leading-relaxed text-braun/75"
        >
            Fotos: Murielle Wüthrich{" · "}
            Webdesign &amp; Umsetzung:{" "}
            <a
                href={linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-1 underline-offset-2 hover:decoration-2"
            >
                Jakob Bauer
                <span class="sr-only">
                    (öffnet LinkedIn in neuem Tab)
                </span>
            </a>
        </p>
    </div>

    <Picture
        src={wave}
        formats={["svg"]}
        widths={[1200, 1600, 2400]}
        sizes="100vw"
        alt=""
        class="block w-full"
        loading="eager"
        fetchpriority="high"
        decoding="async"
    />
</footer>
