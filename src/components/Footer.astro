---
import { Picture } from "astro:assets";
import wave from "../../assets/design-system/huegel-1-umriss.svg";
import logo from "../../assets/design-system/logo-abzeichen.svg";
import herz from "../../assets/design-system/herz.svg";
import { navLinks } from "./Navigation.astro";
---

<footer>
    <Picture
        src={wave}
        formats={["svg"]}
        widths={[1200, 1600, 2400]}
        sizes="100vw"
        alt=""
        class="block w-full"
        loading="eager"
        fetchpriority="high"
        decoding="async"
    />
    <div class="content-section">
        <div class="grid gap-4 items-center md:grid-cols-3">
            <div class="flex flex-col justify-center w-fit">
                <Picture
                    src={logo}
                    formats={["svg"]}
                    alt=""
                    class="block w-60"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
                <strong class="font-heading text-6xl text-center mt-2">
                    Oberhusers <br />
                    Burehof
                </strong>
            </div>
            <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                {navLinks.map((l) => (
                    <a
                        href={l.href}
                        class={`lk ${l.shape} w-fit`}
                        style={`--c: ${l.tone}`}
                    >
                        {l.label}
                    </a>
                ))}
            </div>
            <div>
                <!--TODO: addresse-->
                Addresse
            </div>
        </div>
    </div>
    <div class="px-4 sm:px-8 md:px-24">
        <hr class="text-gray-400/70 border-t-2" />
    </div>
    <div class="px-4 sm:px-8 md:px-24 py-4 text-sm flex gap-4 items-center justify-end">
        <a href="/impressum" class="lk s3" style="--c: var(--color-altrosa)">
            Impressum
        </a>
        <!-- TODO: Add current year dynamically-->
        <span>Alle Rechte Vorbehalten ® 2026</span>
    </div>
</footer>
