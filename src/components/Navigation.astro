---
import logo from "../../assets/design-system/mini-kuh.svg";
import { Picture } from "astro:assets";

export const navLinks = [
    { href: `${import.meta.env.BASE_URL}/eier`, label: "Eier", shape: "s1", tone: "var(--color-gelb)" },
    {
        href: `${import.meta.env.BASE_URL}/kindernachmittage`,
        label: "Kindernachmittage",
        shape: "s2",
        tone: "var(--color-gruen)",
    },
    { href: `${import.meta.env.BASE_URL}/milch`, label: "Milch", shape: "s3", tone: "var(--color-altrosa)" },
    { href: `${import.meta.env.BASE_URL}/ackerbau`, label: "Ackerbau", shape: "s1", tone: "var(--color-gruen)" },
    { href: `${import.meta.env.BASE_URL}/ueber-uns`, label: "Über uns", shape: "s2", tone: "var(--color-altrosa)" },
];
---

<header id="site-header">
    <nav
        aria-label="Hauptnavigation"
        class="relative mx-auto flex items-center justify-between gap-6 px-4 py-4 sm:px-8 md:px-24 md:py-5"
    >
        <a
            href={`${import.meta.env.BASE_URL}/`}
            class="logo"
            aria-label="Oberhusers Burehof – zur Startseite"
        >
            <Picture
                src={logo}
                formats={["svg"]}
                alt="logo"
                loading="eager"
                fetchpriority="high"
                class="max-h-22"
            />
        </a>

        <div class="hidden items-center gap-6 text-[14px] leading-none text-braun/70 lg:flex">
            {navLinks.map((l) => (
                <a
                    href={l.href}
                    class={`lk py-2 ${l.shape}`}
                    style={`--c: ${l.tone}`}
                >
                    {l.label}
                </a>
            ))}
            <a
                href={`${import.meta.env.BASE_URL}/#besuch`}
                class="lk s3 py-2 font-bold"
                style="--c: var(--color-gelb)"
            >
                Vorbeikommen
            </a>
        </div>

        <details class="group lg:hidden">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center gap-1.5 text-[14px] font-bold text-braun marker:hidden [&::-webkit-details-marker]:hidden">
                Menü
                <svg
                    viewBox="0 0 12 12"
                    width="11"
                    height="11"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    aria-hidden="true"
                    class="transition-transform group-open:rotate-180 motion-reduce:transition-none"
                >
                    <path d="M2.5 4.5 6 8l3.5-3.5" />
                </svg>
            </summary>
            <div class="absolute inset-x-0 top-full z-30 border-b-2 border-braun/20 bg-chalk px-4 pb-5 pt-1 sm:px-8">
                <div class="flex flex-col items-start gap-2 text-[16px]">
                    {navLinks.map((l) => (
                        <a
                            href={l.href}
                            class={`lk flex min-h-[44px] items-center py-2 ${l.shape}`}
                            style={`--c: ${l.tone}`}
                        >
                            {l.label}
                        </a>
                    ))}
                    <a
                        href={`${import.meta.env.BASE_URL}/#besuch`}
                        class="lk flex min-h-[44px] items-center py-2 font-bold s3"
                        style="--c: var(--color-gelb)"
                    >
                        Vorbeikommen
                    </a>
                </div>
            </div>
        </details>
    </nav>
</header>
