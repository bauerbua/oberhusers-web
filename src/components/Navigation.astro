---
import logo from "../../assets/design-system/mini-kuh.svg";
import { Picture } from "astro:assets";

export const navLinks = [
    { href: "/eier", label: "Eier" },
    { href: "/kindernachmittage", label: "Kindernachmittage" },
    { href: "/milch", label: "Milch" },
    { href: "/ackerbau", label: "Ackerbau" },
    { href: "/ueber-uns", label: "Über uns" },
];
---

<header id="site-header">
    <nav class="mx-auto flex items-center justify-between gap-6 px-20 md:px-24 py-4 md:py-5">
        <a
            href="/"
            class="logo"
            aria-label="Oberhusers Burehof – zur Startseite"
        >
            <Picture
                src={logo}
                formats={["svg"]}
                alt="logo"
                loading="eager"
                fetchpriority="high"
                class="max-h-22"
            />
        </a>

        <div class="hidden items-center gap-6 text-[14px] leading-none text-braun/70 lg:flex">
            {navLinks.map((l) => (
                <a
                    href={l.href}
                    class="py-2 transition-colors hover:text-braun"
                >
                    {l.label}
                </a>
            ))}
            <a
                href="#besuch"
                class="group flex items-center gap-1.5 py-2 font-bold text-braun"
                data-cta="nav-vorbeikommen"
            >
                Vorbeikommen
            </a>
        </div>

        <details class="group lg:hidden">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center gap-1.5 text-[14px] font-bold text-braun/70 marker:hidden [&::-webkit-details-marker]:hidden">
                Menü
                <svg
                    viewBox="0 0 12 12"
                    width="11"
                    height="11"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <path d="M2.5 4.5 6 8l3.5-3.5" />
                </svg>
            </summary>
            <div class="absolute left-0 right-0 top-full z-30 border-b border-braun/20 bg-chalk px-5 pb-5 pt-1">
                <div class="flex flex-col items-start gap-1 text-[16px] text-braun/80">
                    {navLinks.map((l) => (
                        <a href={l.href} class="py-2">
                            {l.label}
                        </a>
                    ))}
                    <a
                        href="#besuch"
                        class="py-2 font-bold text-braun"
                        data-cta="nav-vorbeikommen"
                    >
                        Vorbeikommen
                    </a>
                </div>
            </div>
        </details>
    </nav>
</header>
