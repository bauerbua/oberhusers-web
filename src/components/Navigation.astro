---
import logo from "../../assets/design-system/logo-abzeichen.svg";
import { Picture } from "astro:assets";
import Button from "./Button.astro";

export const navLinks = [
    {
        href: `${import.meta.env.BASE_URL.replace(/\/$/, "")}/eier`,
        label: "Eier",
        tone: "var(--color-gelb)",
    },
    {
        href: `${import.meta.env.BASE_URL.replace(/\/$/, "")}/chinderhof`,
        label: "Chinderhof",
        tone: "var(--color-gruen)",
    },
    {
        href: `${import.meta.env.BASE_URL.replace(/\/$/, "")}/milch`,
        label: "Milch",
        tone: "var(--color-altrosa)",
    },
    {
        href: `${import.meta.env.BASE_URL.replace(/\/$/, "")}/ackerbau`,
        label: "Ackerbau",
        tone: "var(--color-gruen)",
    },
    {
        href: `${import.meta.env.BASE_URL.replace(/\/$/, "")}/ueber-uns`,
        label: "Über uns",
        tone: "var(--color-altrosa)",
    },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) =>
    href.replace(/\/$/, "") === currentPath;
---

<header id="site-header">
    <nav
        aria-label="Hauptnavigation"
        class="relative mx-auto flex items-center justify-between gap-6 px-4 py-4 sm:px-8 md:px-24 md:py-5"
    >
        <a
            href={`${base}/`}
            class="logo inline-flex w-fit"
            aria-label="Oberhusers Burehof – zur Startseite"
        >
            <Picture
                src={logo}
                formats={["svg"]}
                alt="logo"
                loading="eager"
                fetchpriority="high"
                class="h-22 w-auto"
            />
        </a>

        <div class="hidden items-center gap-6 lg:flex">
            {navLinks.map((l) => (
                <a
                    href={l.href}
                    class={`il ${isCurrent(l.href) ? "is-active" : ""}`}
                    style={`--c: ${l.tone}`}
                    aria-current={isCurrent(l.href) ? "page" : undefined}
                >
                    {l.label}
                </a>
            ))}
            <Button
                href={`${base}/#besuch`}
                tone="wiese"
                shape={1}
                class="text-[14px]"
            >
                Vorbeikommen
            </Button>
        </div>

        <details id="mobile-menu" class="group lg:hidden">
            <summary
                class="group inline-flex min-h-12 cursor-pointer list-none items-center gap-2 rounded-[var(--f1)] bg-braun/8 px-3 text-[17px] font-semibold text-braun transition-colors marker:hidden hover:bg-braun/12 group-open:bg-gelb/50 active:bg-braun/15 [&::-webkit-details-marker]:hidden"
                aria-controls="mobile-menu-panel"
            >
                <span class="group-open:hidden">Menü</span>
                <span class="hidden group-open:inline">Schliessen</span>
                <svg
                    viewBox="0 0 12 12"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                    class="group-open:hidden"
                >
                    <path d="M2.5 4.5 6 8l3.5-3.5" />
                </svg>
                <svg
                    viewBox="0 0 12 12"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                    class="hidden group-open:block"
                >
                    <path d="M3 3l6 6M9 3L3 9" />
                </svg>
            </summary>

            <div
                id="mobile-menu-panel"
                class="absolute inset-x-0 top-full z-30 max-h-[calc(100svh-8rem)] overflow-y-auto overscroll-contain border-b-2 border-braun/20 bg-chalk px-4 pb-6 pt-2 sm:px-8"
            >
                <ul class="flex flex-col divide-y divide-braun/10 text-[17px]">
                    {navLinks.map((l) => (
                        <li>
                            <a
                                href={l.href}
                                class="group flex min-h-[52px] items-center"
                                aria-current={
                                    isCurrent(l.href) ? "page" : undefined
                                }
                            >
                                <span
                                    class={`il ${isCurrent(l.href) ? "is-active" : ""}`}
                                    style={`--c: ${l.tone}`}
                                >
                                    {l.label}
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>

                <Button
                    href={`${base}/#besuch`}
                    tone="wiese"
                    shape={1}
                    class="mt-5"
                >
                    Vorbeikommen
                </Button>
            </div>
        </details>
    </nav>
</header>

<script>
    const menu = document.getElementById("mobile-menu");

    if (menu instanceof HTMLDetailsElement) {
        const summary = menu.querySelector("summary");
        const closeMenu = () => menu.removeAttribute("open");

        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && menu.open) {
                closeMenu();
                summary?.focus();
            }
        });

        document.addEventListener("click", (event) => {
            if (
                menu.open &&
                event.target instanceof Node &&
                !menu.contains(event.target)
            ) {
                closeMenu();
            }
        });

        window
            .matchMedia("(min-width: 1024px)")
            .addEventListener("change", (event) => {
                if (event.matches) closeMenu();
            });
    }
</script>
