---
import { Picture } from "astro:assets";
import hero from "../assets/fotos/garten.jpg";
---

<section class="overflow-hidden pt-2 md:pt-4" aria-labelledby="hero-titel">
    <div class="px-5 pb-10 md:px-8 md:pb-16">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-8">
            <h1
                id="hero-titel"
                class="max-w-full text-balance break-words font-display text-[clamp(2.75rem,8vw,6rem)] font-extrabold leading-[0.9] tracking-[-0.03em]"
            >
                Landwirtschaft zum Erleben.
            </h1>

            <div class="mb-2 shrink-0 text-right md:text-right">
                <p class="mb-2 text-[14px] leading-[1.4] text-ink/55">
                    Entdecke unseren vielseitigen Familienbetrieb im Emmental.
                </p>
                <a
                    href="#besuch"
                    class="group inline-flex min-h-12 items-center gap-2.5 text-[17px] font-bold text-weide"
                    data-cta="hero-vorbeikommen"
                >
                    <span class="border-b border-weide/40 pb-1 transition-colors group-hover:border-weide">
                        Vorbeikommen
                    </span>
                    <svg
                        viewBox="0 0 20 20"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        class="shrink-0 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    >
                        <path d="M4 16 16 4" />
                        <path d="M7.5 4H16v8.5" />
                    </svg>
                </a>
            </div>
        </div>
        <!-- Das Handlungsband: der zweite Weg (Eier) als Kreide-Notiz, oben. -->
        <div class="mt-6 border-t border-line pt-4 motion-safe:animate-hero-in md:mt-8">
            <a
                href="/eier"
                class="group inline-flex items-start gap-1"
                data-cta="hero-eier"
            >
                <svg
                    viewBox="0 0 44 34"
                    width="38"
                    height="29"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    aria-hidden="true"
                    class="mt-1 shrink-0 rotate-[-6deg] text-dotter transition-transform duration-200 group-hover:translate-x-1"
                >
                    <path d="M3 31C7 18 17 8 31 4" />
                    <path d="M31 12.5 31.5 3.5 22.5 4" />
                </svg>
                <span class="font-hand -rotate-1 text-[20px] font-semibold leading-[1.25] text-kastanie underline decoration-kastanie/35 decoration-2 underline-offset-[5px] transition-colors group-hover:decoration-kastanie/80">
                    Eier-Übernahme: von welchem Partnerhof? Was ändert sich?
                </span>
            </a>
        </div>
    </div>
    <div class="mx-auto mt-8 max-w-[1400px] px-5 md:mt-12 md:px-8">
        <div class="hero-foto relative overflow-hidden rounded-[28px] bg-tiefe md:rounded-[36px]">
            <Picture
                src={hero}
                formats={["avif", "jpg"]}
                widths={[1200, 1600, 2400]}
                sizes="calc(100vw - 20px)"
                alt="Der Hof im Sommerlicht: ein Holzbarn mit bunter Girlande, ein grosser Baum und blühende Stauden im Vordergrund."
                class="block h-full w-full object-cover object-[58%_62%]"
                pictureAttributes={{ class: "block h-full w-full" }}
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </div>
    </div>
</section>
