---
import { Picture } from "astro:assets";
import hero from "../assets/fotos/garten-blumen.jpg";
---

<section aria-labelledby="hero-titel">
    <div class="flex flex-col gap-7 px-24 py-18 md:flex-row md:items-end md:justify-between md:gap-12">
        <h1 id="hero-title" class="text-8xl font-heading">
            Ein Burehof zum Erleben.
        </h1>

        <div>
            <p>
                Ein Familienhof im Emmental: Eier, Milch, Acker und Chind — und
                eine Stalltüre, die offen ist.
            </p>

            <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-4">
                <a href="#besuch">Vorbeikommen</a>
                <a href="/eier">Auf der Suche nach Langis Eiern?</a>
            </div>
        </div>
    </div>

    <div class="px-24">
        <!-- TODO: Scroll animation so the image gets larger and fills the screen. Should look like the user "enters" the Burehof and explores the offers-->
        <Picture
            src={hero}
            formats={["avif", "jpg"]}
            alt="Der Hof im Sommerlicht: eine Holzscheune mit bunter Girlande, ein grosser Baum und blühende Stauden im Vordergrund."
            class="block object-cover w-full h-[70vh] rounded-4xl"
            loading="eager"
            fetchpriority="high"
            decoding="async"
        />
    </div>
</section>
