---
import { Picture } from "astro:assets";
import hero from "../assets/fotos/garten-blumen.jpg";
---

<section aria-labelledby="hero-title">
    <div class="px-4 pb-7 pt-4 sm:px-8 md:px-24 md:pb-9 md:pt-6">
        <h1
            id="hero-title"
            class="m-0 text-[clamp(4.5rem,13vw,9.5rem)] font-bold leading-[0.82] tracking-[0.01em] text-balance"
        >
            Oberhusers
        </h1>
        <p class="mt-2 max-w-[36ch] text-[clamp(1.05rem,1.1vw+0.85rem,1.375rem)] leading-snug text-braun/80 md:mt-3">
            Ä Burehof zum Erläbe
        </p>
    </div>

    <!-- TODO: Scroll animation so the image gets larger and fills the screen. Should look like the user "enters" the Burehof and explores the offers-->
    <Picture
        src={hero}
        formats={["avif", "jpg"]}
        alt="Der Hof im Sommerlicht: eine Holzscheune mit bunter Girlande, ein grosser Baum und blühende Stauden im Vordergrund."
        class="block h-[clamp(28rem,70svh,52rem)] w-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
    />
</section>
