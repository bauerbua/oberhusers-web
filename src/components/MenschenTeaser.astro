---
import PlatzhalterBild from "./PlatzhalterBild.astro";

const menschen = [
    {
        name: "Fritz",
        rolle: "Betriebsleiter · Meisterlandwirt",
        text: "Führt den Hof seit [Jahr, TBD] und kennt jeden Stein, jede Kuh, jedes Feld.",
        alt: "Porträt Fritz (Platzhalter)",
    },
    {
        name: "Barbara",
        rolle: "Lehrerin (Volks-/Heilpädagogik) · Kindernachmittage",
        text: "Bringt Kinder und Tiere zusammen — mit Geduld, Struktur und viel Draussen.",
        alt: "Porträt Barbara (Platzhalter)",
    },
    {
        name: "Anne-Lea",
        rolle: "Fachfrau Kinderbetreuung · Landwirtin",
        text: "Zwischen Stall und Kindergruppe zuhause — organisiert die Nachmittage mit.",
        alt: "Porträt Anne-Lea (Platzhalter)",
    },
] as const;
---

<section aria-label="Die Menschen hinter dem Hof">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <h2>
            Hinter dem Hof stehen Menschen
        </h2>
        <a href={`${import.meta.env.BASE_URL}/ueber-uns`} class="btn btn-ghost s3 [--c:var(--color-altrosa)]">Den Hof kennenlernen</a>
    </div>
    <p class="mt-3 max-w-[60ch] text-[17px] leading-relaxed text-braun/70">
        Drei Generationen, klare Verantwortlichkeiten — und ein offenes Tor.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 md:mt-10 md:grid-cols-3 md:gap-8">
        {menschen.map((m) => (
            <article>
                <PlatzhalterBild
                    label={m.alt}
                    ratio="aspect-[4/5]"
                    class="rounded-3xl"
                />
                <h3 class="mt-4">{m.name}</h3>
                <p class="mt-1 font-semibold">{m.rolle}</p>
                <p class="mt-2 leading-relaxed">{m.text}</p>
            </article>
        ))}
    </div>
</section>
