---
import Button from "./Button.astro";
import PersonCard from "./PersonCard.astro";

import { menschen } from "../data/menschen";
---

<section aria-label="Die Menschen hinter dem Hof">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <h2>Die Menschen hinter dem Hof</h2>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 md:mt-10 md:grid-cols-3 md:gap-8">
        {menschen.map((person) => (
            <PersonCard person={person} />
        ))}
    </div>
    <div class="flex justify-center mt-6">
        <Button
            href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/ueber-uns`}
            tone="rind"
            shape={3}
        >
            Den Hof kennenlernen
        </Button>
    </div>
</section>
