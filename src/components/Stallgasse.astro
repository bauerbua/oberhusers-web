---
import { Picture } from "astro:assets";
import TierIcons from "./TierIcons.astro";
import eier from "../assets/fotos/eier.jpg";
import kinder from "../assets/fotos/traktoren.jpg";
import milch from "../assets/fotos/kaelber.jpg";
import acker from "../assets/fotos/garten-blumen.jpg";

const sparten = [
  {
    name: "Eier",
    icon: "huhn",
    text: "Kühlschrank und Abos laufen weiter — neu vom Partner-Hof, mit derselben Sorgfalt.",
    href: "/eier",
    cta: "Eier entdecken",
    notiz: "frisch usem Chaschte",
    bild: eier,
    alt: "Braune Eier liegen dicht an dicht in einer Schicht aus Spelzen.",
    posClass: "object-center",
  },
  {
    name: "Kindernachmittage",
    icon: "hund",
    text: "Einmal im Monat auf den Hof: Tiere kennen, mitarbeiten, draussen sein.",
    href: "/kindernachmittage",
    cta: "Nachmittag finden",
    notiz: "1× im Monet",
    bild: kinder,
    alt: "Eine Reihe bunter Tret-Traktoren steht vor einer Holzwand im Stall.",
    posClass: "object-[50%_62%]",
  },
  {
    name: "Milch",
    icon: "kuh",
    text: "40 Kühe auf der Weide — Milch für echten Emmentaler aus dem Emmental.",
    href: "/milch",
    cta: "Kühe kennenlernen",
    notiz: "40 Kühe",
    bild: milch,
    alt: "Drei Kälber mit gelben Ohrmarken schauen über den Stallzaun in die Kamera.",
    posClass: "object-[50%_45%]",
  },
  {
    name: "Ackerbau",
    icon: "apfel",
    text: "Futter, Kartoffeln, Wald und Obst: der Kreislauf hinter allem.",
    href: "/ackerbau",
    cta: "Feld & Obst sehen",
    notiz: "30 ha",
    bild: acker,
    alt: "Ein Beet mit gelben und rosa Blüten vor einer Holzfassade mit bunter Girlande.",
    posClass: "object-[50%_85%]",
  },
] as const;
---

<section class="px-5 md:px-8" aria-label="Unsere Sparten">
    <div class="space-y-14 md:space-y-24">
        {sparten.map((s, i) => (
            <article class={`grid items-center gap-6 md:gap-12 ${i % 2 ? "md:grid-cols-[1fr_1.12fr] md:[&>*:first-child]:order-2" : "md:grid-cols-[1.12fr_1fr]"}`}>
                <a
                    href={s.href}
                    class="group relative block overflow-hidden rounded-[24px] bg-tiefe md:rounded-[30px]"
                    aria-label={`${s.name}: ${s.cta}`}
                >
                    <Picture
                        src={s.bild}
                        formats={["avif", "jpg"]}
                        widths={[800, 1200, 1600]}
                        sizes="(min-width: 768px) 620px, calc(100vw - 40px)"
                        alt={s.alt}
                        class={`block aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.035] ${s.posClass}`}
                        pictureAttributes={{ class: "block" }}
                        loading="lazy"
                        decoding="async"
                    />
                    <span class="absolute left-4 top-4 flex h-12 w-12 items-center justify-center rounded-full bg-chalk/95 ring-1 ring-ink/10 md:h-14 md:w-14">
                        <TierIcons name={s.icon} class="h-7 w-7 md:h-9 md:w-9" />
                    </span>
                </a>

                <div>
                    <h3 class="font-display text-2xl font-extrabold tracking-tight md:text-3xl">{s.name}</h3>
                    <p class="mt-2 max-w-[46ch] text-[17px] leading-relaxed text-ink/75">{s.text}</p>
                    <div class="mt-5 flex flex-wrap items-baseline gap-x-5 gap-y-3">
                        <span class="inline-flex min-h-11 items-center rounded-xl border-2 border-dotter bg-dotter px-4 py-1.5 text-sm font-bold uppercase tracking-wide text-dotter-ink transition group-hover:border-weide-tief group-hover:bg-weide-tief group-hover:text-chalk">
                            {s.cta} →
                        </span>
                        <span class="font-hand text-[20px] text-kastanie/80" aria-hidden="true">{s.notiz}</span>
                    </div>
                </div>
            </article>
        ))}
    </div>
</section>
