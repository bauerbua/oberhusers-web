---
import { Picture } from "astro:assets";

import type { Person } from "../data/menschen";

interface Props {
    person: Person;
    /**
     * `teaser`: Kurztext für die Startseite.
     * `profil`: Langtext und Verantwortungsbereiche für «Über uns».
     */
    variant?: "teaser" | "profil";
    class?: string;
}

const { person, variant = "teaser", class: className } = Astro.props;
const text = variant === "profil" ? person.lang : person.kurz;
---

<article
    class:list={["person-card", className]}
    style={`--person-bild-position: ${person.bildPosition ?? "50% 50%"}`}
>
    <Picture
        src={person.bild}
        alt={person.bildAlt}
        class="aspect-4/5 w-full rounded-3xl object-cover"
    />

    <h3 class="mt-4">{person.name}</h3>
    <p class="mt-1 font-semibold">{person.rolle}</p>
    <p class="mt-2 leading-relaxed">{text}</p>

    {
        variant === "profil" && (
            <>
                <p class="mt-3 font-semibold">Verantwortungsbereiche</p>
                <ul class="mt-1 list-disc pl-5">
                    {person.aufgaben.map((aufgabe) => (
                        <li>{aufgabe}</li>
                    ))}
                </ul>
            </>
        )
    }
</article>

<style>
    .person-card :global(img) {
        object-position: var(--person-bild-position);
    }
</style>
