---
export interface Props { name: "huhn" | "hund" | "kuh" | "apfel"; class?: string; }
const { name, class: cls = "h-20 w-20" } = Astro.props;
const stroke = "currentColor";
---
{name === "huhn" && (
  <svg viewBox="0 0 96 96" fill="none" class={cls} role="img" aria-label="Huhn">
    <ellipse cx="46" cy="60" rx="24" ry="20" fill="#fff" stroke={stroke} stroke-width="3"/>
    <path d="M30 74 l-3 10 M30 74 l4 10 M58 74 l-2 10 M58 74 l5 9" stroke={stroke} stroke-width="3" stroke-linecap="round"/>
    <path d="M66 52 q14 -2 16 -16 q-12 0 -18 8" fill="#fff" stroke={stroke} stroke-width="3" stroke-linejoin="round"/>
    <g class="tier-anim huhn-kopf">
      <circle cx="68" cy="38" r="13" fill="#fff" stroke={stroke} stroke-width="3"/>
      <path d="M60 28 q2 -8 8 -9 q-1 5 -2 7 q4 -3 8 -2 q-3 5 -8 6" fill="#B08968" stroke={stroke} stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M80 36 l9 3 l-9 4 z" fill="#E9C46A" stroke={stroke} stroke-width="2.5" stroke-linejoin="round"/>
      <circle cx="70" cy="36" r="2.4" fill={stroke}/>
    </g>
  </svg>
)}
{name === "hund" && (
  <svg viewBox="0 0 96 96" fill="none" class={cls} role="img" aria-label="Hund">
    <g class="tier-anim hund-schwanz">
      <path d="M20 62 q-12 -4 -10 -20" stroke={stroke} stroke-width="4" stroke-linecap="round"/>
    </g>
    <ellipse cx="52" cy="60" rx="24" ry="18" fill="#fff" stroke={stroke} stroke-width="3"/>
    <path d="M36 46 q-10 -14 -2 -24 q10 4 10 16" fill="#B08968" stroke={stroke} stroke-width="3" stroke-linejoin="round"/>
    <path d="M66 46 q10 -14 2 -24 q-10 4 -10 16" fill="#B08968" stroke={stroke} stroke-width="3" stroke-linejoin="round"/>
    <circle cx="52" cy="46" r="16" fill="#fff" stroke={stroke} stroke-width="3"/>
    <ellipse cx="52" cy="52" rx="8" ry="6.5" fill="#fff" stroke={stroke} stroke-width="2.5"/>
    <circle cx="52" cy="49" r="2.6" fill={stroke}/>
    <circle cx="45" cy="42" r="2.4" fill={stroke}/>
    <circle cx="59" cy="42" r="2.4" fill={stroke}/>
    <path d="M40 74 l-2 8 M64 74 l2 8" stroke={stroke} stroke-width="3" stroke-linecap="round"/>
  </svg>
)}
{name === "kuh" && (
  <svg viewBox="0 0 96 96" fill="none" class={cls} role="img" aria-label="Kuh">
    <path d="M30 26 q-8 -10 -18 -8 q8 8 12 12" fill="#fff" stroke={stroke} stroke-width="3" stroke-linecap="round"/>
    <path d="M66 26 q8 -10 18 -8 q-8 8 -12 12" fill="#fff" stroke={stroke} stroke-width="3" stroke-linecap="round"/>
    <g class="tier-anim kuh-ohr">
      <ellipse cx="22" cy="44" rx="10" ry="7" fill="#fff" stroke={stroke} stroke-width="3" transform="rotate(-20 22 44)"/>
    </g>
    <ellipse cx="74" cy="44" rx="10" ry="7" fill="#fff" stroke={stroke} stroke-width="3" transform="rotate(20 74 44)"/>
    <rect x="30" y="28" width="36" height="44" rx="14" fill="#fff" stroke={stroke} stroke-width="3"/>
    <path d="M38 34 q4 5 0 10 M58 34 q-4 5 0 10" stroke="#B08968" stroke-width="3" stroke-linecap="round"/>
    <circle cx="42" cy="48" r="2.6" fill={stroke}/>
    <circle cx="54" cy="48" r="2.6" fill={stroke}/>
    <ellipse cx="48" cy="62" rx="11" ry="8" fill="#F3E7D3" stroke={stroke} stroke-width="2.5"/>
    <circle cx="44" cy="62" r="1.8" fill={stroke}/>
    <circle cx="52" cy="62" r="1.8" fill={stroke}/>
  </svg>
)}
{name === "apfel" && (
  <svg viewBox="0 0 96 96" fill="none" class={cls} role="img" aria-label="Apfel">
    <path d="M48 34 q2 -10 8 -14" stroke="#6E4A2C" stroke-width="3.5" stroke-linecap="round"/>
    <g class="tier-anim apfel-blatt">
      <path d="M56 26 q16 -6 22 6 q-12 8 -22 -6" fill="#7D8C6F" stroke={stroke} stroke-width="2.5" stroke-linejoin="round"/>
    </g>
    <path d="M48 40 q-6 -6 -16 -4 q-10 2 -10 14 q0 24 16 30 q6 2 10 0 q4 2 10 0 q16 -6 16 -30 q0 -12 -10 -14 q-10 -2 -16 4" fill="#fff" stroke={stroke} stroke-width="3" stroke-linejoin="round"/>
    <path d="M38 52 q-3 12 4 20" stroke="#B08968" stroke-width="3" stroke-linecap="round"/>
  </svg>
)}
