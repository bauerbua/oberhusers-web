---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Angebot from "../components/Angebot.astro";
import VertrauenLabels from "../components/VertrauenLabels.astro";
import BesuchModul from "../components/BesuchModul.astro";
import MenschenTeaser from "../components/MenschenTeaser.astro";
import Aktuelles from "../components/Aktuelles.astro";
---

<style>
    @import "tailwindcss";

    div {
        @apply my-20 md:my-28;
    }
</style>

<Base title="Start">
    <Hero />

    <div class="content-section">
        <Aktuelles />
    </div>

    <div class="content-section">
        <Angebot />
    </div>

    <div class="content-section">
        <VertrauenLabels />
    </div>

    <div class="content-section">
        <MenschenTeaser />
    </div>

    <div class="content-section">
        <BesuchModul />
    </div>
</Base>
