---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import AltchaWidget from "../components/altcha-widget.astro";

const eierabos = [
    { name: "500er", lieferungen: 25, menge: 20, preis: "350" },
    { name: "450er", lieferungen: 25, menge: 18, preis: "337.50" },
    { name: "300er", lieferungen: 25, menge: 12, preis: "225" },
    { name: "250er", lieferungen: 25, menge: 10, preis: "200" },
    { name: "150er", lieferungen: 25, menge: 6, preis: "127.50" },
] as const;
---

<Base
    title="Eier"
    description="Freilandeier vom Hof Oberhusers – Eierabo-Preise für Langnau und Umgebung."
>
    <div class="content-section">
        <h1>Hühner &amp; Eier</h1>
        <p>
            Seit November 2026 bereichern 600 braune und weisse Legehennen
            unseren Hof. In zwei mobilen Hühnerställen leben sie auf unseren
            Wiesen und können draussen scharren &amp; picken. Mit dem Traktor
            ziehen wir die Ställe regelmässig weiter, damit unsere Hühner immer
            wieder neue Flächen erkunden können. Vier Hähne gehören ebenfalls
            zur Gruppe und sorgen für zusätzliche Ruhe im Hühneralltag.
        </p>
        <p>
            Unsere Eier liefern wir an Bäckereien, Hotels, Restaurants,
            Dorfläden sowie an die Käserei und Metzgerei in der Region. Auch
            Privathaushalte können unsere Eier geniessen: Mit einem Eierabo
            kommen alle zwei Wochen frische Eier direkt in den Briefkasten. Wer
            lieber spontan vorbeikommt, kann die Eier auch direkt bei uns auf
            dem Hof kaufen.
        </p>
        <p>
            Mit der Übernahme von Langis Freilandeier von Christian Langenegger
            führen wir ein bestehendes Herzensprojekt weiter. Wir übernehmen
            sein bewährtes Konzept und führen die Haltung der Hühner so weiter,
            wie sie bisher gelebt wurde. Gleichzeitig freuen wir uns, diesen
            neuen Betriebszweig in unsere Hofgemeinschaft aufzunehmen und unsere
            Region weiterhin mit frischen Freilandeiern zu versorgen.
        </p>

        <section aria-labelledby="eierabo-preise-titel" class="mt-14">
            <h2 id="eierabo-preise-titel">Eierabo-Preise</h2>
            <p class="max-w-[60ch]">
                Für ein Jahr in Langnau und nahe Umgebung: 25 Lieferungen, alle
                zwei Wochen.
            </p>

            <ul class="mt-6 border-y border-braun/15">
                {eierabos.map((abo) => (
                    <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-braun/15 py-4 last:border-b-0">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <span class="text-[19px] font-semibold">
                                {abo.name}
                            </span>
                            <span class="text-[15px] text-braun/70">
                                {abo.lieferungen} Lieferungen à {abo.menge} Eier
                            </span>
                        </div>
                        <span class="text-[17px] font-semibold tabular-nums">
                            CHF {abo.preis}
                        </span>
                    </li>
                ))}
            </ul>
        </section>

        <form
            action={`/api/forms.php`}
            method="post"
            data-form="eierabo"
            class="mt-14"
        >
            <input type="hidden" name="_form" value="eierabo" />

            <!-- Honeypot: hidden from real visitors -->
            <div class="absolute left-[-9999px]" aria-hidden="true">
                <label for="website">Website</label>
                <input
                    id="website"
                    type="text"
                    name="website"
                    tabindex="-1"
                    autocomplete="off"
                />
            </div>

            <h2>Interesse an einem Eierabo?</h2>
            <p>
                Nach Absenden, melden wir melden uns sobald wie möglich bei dir.
                Mit * markierte Felder sind Pflichtfelder.
            </p>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
                <div class="field">
                    <label for="vorname">Vorname</label>
                    <input
                        id="vorname"
                        type="text"
                        name="vorname"
                        required
                        autocomplete="given-name"
                        aria-describedby="vorname-error"
                    />
                    <p class="field-error" id="vorname-error">
                        Bitte Vornamen angeben.
                    </p>
                </div>

                <div class="field">
                    <label for="nachname">Nachname</label>
                    <input
                        id="nachname"
                        type="text"
                        name="nachname"
                        required
                        autocomplete="family-name"
                        aria-describedby="nachname-error"
                    />
                    <p class="field-error" id="nachname-error">
                        Bitte Nachnamen angeben.
                    </p>
                </div>

                <div class="field">
                    <label for="email">E-Mail</label>
                    <input
                        id="email"
                        type="email"
                        name="email"
                        required
                        autocomplete="email"
                        aria-describedby="email-error"
                    />
                    <p class="field-error" id="email-error">
                        Bitte eine gültige E-Mail-Adresse angeben.
                    </p>
                </div>

                <div class="field">
                    <label for="telefon">Telefon</label>
                    <input
                        id="telefon"
                        type="tel"
                        name="telefon"
                        autocomplete="tel"
                    />
                </div>

                <div class="field md:col-span-2">
                    <label for="strasse">Strasse und Hausnummer</label>
                    <input
                        id="strasse"
                        type="text"
                        name="strasse"
                        required
                        autocomplete="street-address"
                        aria-describedby="strasse-error"
                    />
                    <p class="field-error" id="strasse-error">
                        Bitte Strasse und Nummer angeben.
                    </p>
                </div>

                <div class="field">
                    <label for="plz">PLZ</label>
                    <input
                        id="plz"
                        type="text"
                        name="plz"
                        required
                        inputmode="numeric"
                        autocomplete="postal-code"
                        aria-describedby="plz-error"
                    />
                    <p class="field-error" id="plz-error">
                        Bitte PLZ angeben.
                    </p>
                </div>

                <div class="field">
                    <label for="ort">Ort</label>
                    <input
                        id="ort"
                        type="text"
                        name="ort"
                        required
                        autocomplete="address-level2"
                        aria-describedby="ort-error"
                    />
                    <p class="field-error" id="ort-error">
                        Bitte Ort angeben.
                    </p>
                </div>

                <div class="field">
                    <label for="abo">Eierabo</label>
                    <select id="abo" name="abo">
                        <option value="">Noch unsicher</option>
                        {eierabos.map((abo) => (
                            <option value={abo.name}>
                                {abo.name} – {abo.lieferungen} × {abo.menge}{" "}
                                Eier
                            </option>
                        ))}
                    </select>
                </div>

                <div class="field md:col-span-2">
                    <label for="nachricht">Nachricht (optional)</label>
                    <textarea id="nachricht" name="nachricht"></textarea>
                </div>
            </div>

            <AltchaWidget floatingAnchor="#submit-eier-form" />

            <Button
                id="submit-eier-form"
                type="submit"
                tone="egg"
                shape={1}
                class="mt-6"
            >
                Absenden
            </Button>
        </form>
    </div>
</Base>
