---
import Base from "../layouts/Base.astro";
---

<Base
    title="Eier"
    description="Unsere Eierproduktion wurde übernommen – was bleibt, was ändert sich."
>
    <div class="px-5 pt-10 md:px-8">
        <h1>
            Eier – neu vom Partner-Hof [TBD]
        </h1>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
            <div class="rounded-[20px] border border-braun/20 bg-chalk/60 p-6">
                <h2>Was bleibt gleich</h2>
                <ul class="mt-2 list-disc pl-5 text-[15px]">
                    <li>Eierkühlschrank jederzeit, bar/QR</li>
                    <li>Abos / B2B laufen weiter</li>
                    <li>Ansprechpartner Hof Oberhusers</li>
                </ul>
            </div>
            <div class="rounded-[20px] border border-braun/20 bg-chalk/60 p-6">
                <h2>Was sich ändert</h2>
                <p class="mt-2 text-[15px]">
                    Produktion bei [Partner-Hof, TBD] – Haltung [TBD, 2–3
                    Sätze].{" "}
                    <a class="il [--c:var(--color-gelb)]" href="#">
                        Zum Partner-Hof
                    </a>
                </p>
            </div>
        </div>
        <form
            class="mt-8 rounded-[20px] border border-braun/20 bg-chalk/60 p-6"
        >
            <h2>Interesse an Eiern / Abo</h2>
            <div class="mt-4 grid gap-3 md:grid-cols-2">
                <input
                    required
                    placeholder="Name"
                    class="rounded-xl border border-braun/20 bg-chalk px-4 py-2.5"
                />
                <input
                    required
                    placeholder="Kontakt (Tel/Mail)"
                    class="rounded-xl border border-braun/20 bg-chalk px-4 py-2.5"
                />
                <input
                    placeholder="Menge / Häufigkeit"
                    class="rounded-xl border border-braun/20 bg-chalk px-4 py-2.5"
                />
                <select class="rounded-xl border border-braun/20 bg-chalk px-4 py-2.5">
                    <option>Haushalt</option>
                    <option>Geschäft</option>
                </select>
            </div>
            <textarea
                placeholder="Nachricht (optional)"
                class="mt-3 w-full rounded-xl border border-braun/20 bg-chalk px-4 py-2.5"
            ></textarea>
            <button class="btn s1 [--c:var(--color-gelb)] mt-4">Interesse senden [Versand via PostHog TBD]</button>
        </form>
        <div class="mt-8 text-[15px]">
            <h2>FAQ [TBD]</h2>
            <p class="mt-2 text-braun/70">
                Warum neuer Hof? Ändert sich Preis/Abholung? Woher kommen die
                Eier jetzt?
            </p>
        </div>
    </div>
</Base>
